pnpm exec lint-staged

# SEC-S-001: block staged secrets. Fails closed when gitleaks is missing.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the secret check can't run." >&2
  echo "Install it from a Start-menu PowerShell: winget install -e --id Gitleaks.Gitleaks" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner
